# Sao chép thành .env rồi điền giá trị thật. Không commit file .env.
# Quy ước: DECISION_<PROVIDER>_<THUỘC_TÍNH>. Tên provider viết thường trong
# DECISION_ENABLED_PROVIDERS; có thể thêm provider mới chuẩn Jev chỉ bằng cấu hình.

# ---- Chung ----
DECISION_ENABLED_PROVIDERS=laya,openrouter,jev,vercelgateway

# ---- Laya tự host (đã kiểm chứng) ----
DECISION_LAYA_ENDPOINT=http://127.0.0.1:8000/v1/systemone
DECISION_LAYA_API_KEY=
DECISION_LAYA_DEFAULT_MODEL=multilingual
DECISION_LAYA_ADAPTER=jev_native
DECISION_LAYA_TIMEOUT_S=60
DECISION_LAYA_MIN_INTERVAL_S=0
DECISION_LAYA_MAX_RETRIES=2

# ---- OpenRouter Decisions API (đã kiểm chứng với respan/span-01-lite:free) ----
DECISION_OPENROUTER_ENDPOINT=https://openrouter.ai/api/alpha/decisions
DECISION_OPENROUTER_API_KEY=
DECISION_OPENROUTER_DEFAULT_MODEL=respan/span-01-lite:free
# Respan chỉ nhận câu noul -> phải phân rã. Đổi sang jev_native nếu dùng model hỗ trợ choice.
DECISION_OPENROUTER_ADAPTER=noul_decomposition
DECISION_OPENROUTER_TIMEOUT_S=60
DECISION_OPENROUTER_MIN_INTERVAL_S=1.0
DECISION_OPENROUTER_MAX_RETRIES=5

# ---- TypeSafe Jev (CHƯA kiểm chứng endpoint) ----
DECISION_TYPESAFE_ENDPOINT=
DECISION_TYPESAFE_API_KEY=
DECISION_TYPESAFE_DEFAULT_MODEL=jev-1.13
DECISION_TYPESAFE_ADAPTER=jev_native

# ---- Vercel AI Gateway (CHƯA kiểm chứng có hỗ trợ decisions hay không) ----
DECISION_VERCELGATEWAY_ENDPOINT=
DECISION_VERCELGATEWAY_API_KEY=
DECISION_VERCELGATEWAY_DEFAULT_MODEL=
DECISION_VERCELGATEWAY_ADAPTER=jev_native
